    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.28.0",
    "@grammyjs/runner": "^2.0.3",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": "true",
  "engines": {
    "node": ">=22.13"
  }
}
