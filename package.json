{
  "name": "my-nova-agent",
  "version": "1.0.0",
  "description": "Nova — Telegram AI agent (@MyNovaAgent_bot)",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
