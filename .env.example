# Bu fayl namuna. Nusxasini .env deb saqla va qiymatlarni to'ldir.
# .env hech qachon GitHub'ga yuklanmaydi (.gitignore'da bor).

# @BotFather bergan token
BOT_TOKEN=123456789:AAH_your_token_from_BotFather_goes_here

# Sening Telegram ID raqaming (username EMAS). @userinfobot orqali bilib olasan.
OWNER_TELEGRAM_ID=111111111

# open = hamma foydalana oladi, allowlist = faqat /allow qilinganlar
ACCESS_MODE=open

# SQLite fayl manzili
DATABASE_PATH=./data/nova.db

# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------------- AI ----------------
# Ikkita variant bor: Google Gemini (bepul tarifi bor) yoki Anthropic Claude (pullik).
# Faqat BITTA kalitni to'ldir — Nova o'zi tanlaydi.
# Ikkalasi ham bo'sh bo'lsa Nova ishlaydi, lekin AI o'chiq bo'ladi.

# --- Google Gemini ---
# aistudio.google.com -> Get API key. Odatda "AIza..." bilan boshlanadi.
# Bepul tarifda xabarlar Google tomonidan xizmatlarini yaxshilash uchun ishlatilishi mumkin.
GEMINI_API_KEY=

# Gemini modeli. gemini-3.5-flash-lite — tez va bepul limiti kengroq.
# gemini-3.8-flash aqlliroq, lekin bepul tarifda kuniga atigi ~20 ta so'rov (2026-10 holatiga).
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude ---
# platform.claude.com -> API Keys. "sk-ant-api..." bilan boshlanadi.
# Console'da albatta oylik spending limit qo'y!
ANTHROPIC_API_KEY=

# Ikkala kalit ham qo'yilgan bo'lsa, qaysi biri ishlashini tanla: claude yoki gemini
LLM_PROVIDER=

# Claude modeli. Standart: claude-opus-5-5 (eng aqlli, qimmatroq).
# Arzonroq variant: claude-haiku-5-5 (narxlar uchun README/Console'ni ko'r).
LLM_MODEL=claude-opus-5-5

# Claude qancha "o'ylashi": low | medium | high | xhigh | max. Suhbat uchun low yetarli.
LLM_EFFORT=low

# Bitta javob uchun maksimal token (o'ylash + javob)
LLM_MAX_TOKENS=4096

# Claude javob bermasa necha soniyadan keyin to'xtatiladi
LLM_TIMEOUT_SECONDS=60

# Har bir suhbatdan nechta oxirgi xabar AI'ga yuboriladi
HISTORY_LIMIT=20

# Owner'dan boshqa har bir foydalanuvchi uchun kunlik xabar limiti
DAILY_MESSAGES_PER_USER=30

# Hamma uchun umumiy kunlik token byudjeti. Tugasa Nova ertagacha dam oladi.
DAILY_TOKEN_BUDGET=300000
